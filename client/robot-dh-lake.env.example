# robot-dh v1.4 lake client environment template.
#
# - 默认占位值，不可直接用于生产。
# - 在云端服务器执行：
#     ./scripts/24_export_lake_client_env.sh --show-secrets
#   即可生成包含真实凭据的 client/robot-dh-lake.env。
# - 占位 host 假定为本地 SSH tunnel 模式（127.0.0.1 + 15432 / 19000 / 16379）。
#   如果改为公网直连，请把 host 替换为 PUBLIC_SERVER_IP_OR_DNS 并使用 5432 / 9000 / 6379。

# PostgreSQL 应用账号连接串，指向 robot_dh 数据库
ROBOT_DH_DB_URI=postgresql+psycopg://robot_dh_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:15432/robot_dh

# 对象存储选择 S3 兼容协议，由 MinIO 提供
ROBOT_DH_ARTIFACT_STORE=s3
ROBOT_DH_S3_ENDPOINT_URL=http://127.0.0.1:19000
ROBOT_DH_S3_ACCESS_KEY=robotdhapp
ROBOT_DH_S3_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET

# v1.3 bucket：原始机器人数据 / 通用 artifacts
ROBOT_DH_S3_DATA_BUCKET=robot-datasets
ROBOT_DH_S3_ARTIFACT_BUCKET=robot-dh-artifacts

# v1.4 新增 bucket：数据湖统一 bucket（raw / ods / dwd / ads / lineage / tmp）
ROBOT_DH_S3_LAKE_BUCKET=robot-lake

# Redis URL，用于 connectivity check 和后续任务队列
ROBOT_DH_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16379/0
